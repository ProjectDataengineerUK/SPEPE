*.py[cod]
*.so
.Python
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# Virtual envs
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# KFP compiled pipelines — regenerated at deploy time
output/ml_pipeline.yaml
